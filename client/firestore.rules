rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['patient','donor','hospital']
        && request.resource.data.hospitalVerified == false;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','username','bio','age','height','weight','bloodGroup','photoURL','photoSource','donorInterested','privacy','updatedAt'
        ]);
      allow delete: if false;
    }
    match /bloodInventory/{itemId} {
      allow read: if request.auth != null;
      allow write: if false; // Administrator-controlled until hospital verification backend exists.
    }
    match /donationCamps/{campId} {
      allow read: if request.auth != null;
      allow write: if false; // Administrator-controlled demo records.
    }
  }
}
